---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

// Only list services PerfectWnętrza actually offers.
const services = [
	{
		title: 'Sprzątanie klatek schodowych',
		text: 'Dla wspólnot mieszkaniowych, zarządców i właścicieli budynków. Mycie schodów, podłóg i poręczy, drzwi oraz okien na klatce. Zakres i częstotliwość ustalamy indywidualnie.',
		image: '/cleaning/klatka.svg',
		alt: 'Sprzątanie klatki schodowej',
		main: true,
	},
	{
		title: 'Sprzątanie po remoncie',
		text: 'Usuwanie pyłu, resztek farby, kleju i fug, mycie okien, podłóg i armatury — tak, aby wnętrze było gotowe do zamieszkania lub otwarcia.',
		image: '/cleaning/po-remoncie.svg',
		alt: 'Sprzątanie mieszkania po remoncie',
	},
	{
		title: 'Sprzątanie obiektów komercyjnych',
		text: 'Biura, sklepy, lokale usługowe i inne obiekty komercyjne. Sprzątanie jednorazowe lub regularne — zakres i terminy ustalamy razem z Tobą.',
		image: '/cleaning/komercyjne.svg',
		alt: 'Sprzątanie biura',
	},
	{
		title: 'Sprzątanie obiektów niekomercyjnych',
		text: 'Szkoły, szpitale i inne obiekty użyteczności publicznej. Zakres prac i harmonogram dopasowujemy do specyfiki obiektu.',
		image: '/cleaning/niekomercyjne.svg',
		alt: 'Sprzątanie sali lekcyjnej',
	},
];

const steps = [
	{ title: 'Opisz, czego potrzebujesz', text: 'Wypełnij formularz lub zadzwoń — powiedz, jaki obiekt i jaki zakres sprzątania.' },
	{ title: 'Bezpłatna wycena', text: 'Przygotujemy wycenę dopasowaną do powierzchni i zakresu prac.' },
	{ title: 'Ustalamy termin i sprzątamy', text: 'Jednorazowo lub regularnie — tak, jak ustalimy.' },
];
---

<Layout
	title="Sprzątanie klatek schodowych, obiektów i po remoncie — PerfectWnętrza"
	description="Sprzątanie klatek schodowych, obiektów komercyjnych i niekomercyjnych (biura, sklepy, szkoły, szpitale) oraz sprzątanie po remoncie w Krakowie i okolicach. Bezpłatna wycena."
>
	<Header />
	<main>
		<section class="hero">
			<div class="container">
				<span class="eyebrow">Sprzątanie</span>
				<h1>Czyste klatki schodowe, obiekty <em>i wnętrza po remoncie</em></h1>
				<p class="lead">
					Sprzątamy klatki schodowe, obiekty komercyjne i niekomercyjne — takie jak biura, sklepy,
					szkoły czy szpitale — oraz wnętrza po remoncie. Zakres i częstotliwość ustalamy
					indywidualnie, a wycena jest bezpłatna.
				</p>
				<div class="actions">
					<a href="#kontakt" class="btn btn-primary">Bezpłatna wycena</a>
					<a href="#zakres" class="btn btn-ghost">Zobacz zakres</a>
				</div>
			</div>
		</section>

		<section class="section offer" id="zakres">
			<div class="container">
				<span class="eyebrow">Zakres usług</span>
				<h2 class="section-title">Co sprzątamy</h2>

				<ul class="cards">
					{
						services.map((s, i) => (
							<li class:list={['card', { main: s.main }]}>
								<img class="illus" src={s.image} alt={s.alt} width="779" height="620" loading="lazy" />
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="section steps-section">
			<div class="container">
				<span class="eyebrow">Jak to działa</span>
				<h2 class="section-title">Trzy proste kroki</h2>
				<ol class="steps">
					{
						steps.map((s, i) => (
							<li>
								<span class="num">{String(i + 1).padStart(2, '0')}</span>
								<h3>{s.title}</h3>
								<p>{s.text}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<Contact service="Sprzątanie" />
	</main>
	<Footer />
</Layout>

<style>
	.hero {
		padding: 88px 0 96px;
	}
	h1 {
		max-width: 820px;
		font-size: clamp(36px, 5vw, 60px);
		letter-spacing: -0.015em;
	}
	h1 em {
		color: var(--accent);
		font-style: normal;
		font-weight: 400;
	}
	.lead {
		margin-top: 28px;
		max-width: 560px;
		font-size: 18px;
		color: var(--muted);
		font-weight: 300;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 40px;
	}

	.offer {
		background: var(--surface);
	}
	.cards {
		list-style: none;
		margin: 56px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.card {
		padding: 40px 36px 44px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		transition: background 0.25s;
	}
	.card:hover,
	.card.main {
		background: var(--bg);
	}
	/* Stairwell cleaning is the key service: bronze line on top. */
	.card.main {
		box-shadow: inset 0 3px 0 var(--accent);
	}
	.illus {
		width: calc(100% + 24px);
		max-width: none;
		height: auto;
		margin: -12px -12px 20px;
		transition: transform 0.35s ease;
	}
	.card:hover .illus {
		transform: translateY(-4px);
	}
	.card .num {
		margin-bottom: 12px;
	}
	.card h3 {
		font-size: 22px;
		font-weight: 400;
		margin-bottom: 14px;
	}
	.card p {
		color: var(--muted);
		font-size: 15px;
	}

	.steps {
		list-style: none;
		margin: 56px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 40px;
	}
	.steps li {
		padding-top: 24px;
		border-top: 1px solid var(--line);
	}
	.num {
		display: block;
		font-family: var(--font-serif);
		font-size: 18px;
		color: var(--accent);
		margin-bottom: 12px;
	}
	.steps h3 {
		font-size: 20px;
		font-weight: 400;
		margin-bottom: 10px;
	}
	.steps p {
		color: var(--muted);
		font-size: 15px;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr;
			gap: 28px;
		}
	}
	@media (max-width: 600px) {
		.hero {
			padding: 48px 0 72px;
		}
		.cards {
			grid-template-columns: 1fr;
		}
		.card {
			padding: 32px 24px;
		}
	}
</style>
