---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import Steps from '../components/Steps.astro';
import PageHero from '../components/PageHero.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import { getLang, useT } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang);
const c = t.cleaning;

// Only list services PerfectWnętrza actually offers. Text: i18n dictionaries (cleaning.cards, same order).
const images = ['/cleaning/klatka.svg', '/cleaning/po-remoncie.svg', '/cleaning/komercyjne.svg', '/cleaning/niekomercyjne.svg', '/cleaning/najem.svg'];
const services = c.cards.map((card, i) => ({ ...card, image: images[i] }));
---

<Layout title={c.metaTitle} description={c.metaDescription}>
	<Header />
	<main>
		<PageHero
			eyebrow={c.eyebrow}
			title={c.title}
			titleAccent={c.titleAccent}
			lead={c.lead}
			image="/cleaning/hero.svg"
			alt={c.heroAlt}
			badge={{ small: c.badgeSmall, big: c.badgeBig }}
			secondary={{ href: '#zakres', label: t.common.seeScope }}
		/>

		<section class="section offer" id="zakres">
			<div class="container">
				<span class="eyebrow">{c.offerEyebrow}</span>
				<h2 class="section-title">{c.offerTitle}</h2>

				<ul class="cards">
					{
						services.map((s, i) => (
							<li class="card">
								<img class="illus" src={s.image} alt={s.alt} width="779" height="620" loading="lazy" />
								<div class="card-text">
									<span class="num">{String(i + 1).padStart(2, '0')}</span>
									<h3>{s.title}</h3>
									<p>{s.text}</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<Steps kind="cleaning" />

		<Reviews topic="cleaning" />

		<Faq items={t.faq.cleaning} />

		<Contact kind="cleaning" />
	</main>
	<Footer />
</Layout>

<style>
	.offer {
		background: var(--surface);
	}
	.cards {
		list-style: none;
		margin: 56px 0 0;
		padding: 0;
		display: grid;
		/* Desktop: two wide cards, then three. */
		grid-template-columns: repeat(6, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.card {
		grid-column: span 2;
		padding: 40px 36px 44px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		transition: background 0.25s;
	}
	.card:nth-child(-n + 2) {
		grid-column: span 3;
	}
	.card:hover {
		background: var(--bg);
	}
	.illus {
		width: calc(100% + 24px);
		max-width: none;
		height: auto;
		margin: -12px -12px 20px;
		transition: transform 0.35s ease;
	}
	.card:hover .illus {
		transform: translateY(-4px);
	}
	.card .num {
		display: block;
		font-family: var(--font-serif);
		font-size: 18px;
		color: var(--accent);
		margin-bottom: 12px;
	}
	.card h3 {
		font-size: 22px;
		font-weight: 400;
		margin-bottom: 14px;
	}
	.card p {
		color: var(--muted);
		font-size: 15px;
	}

	/* Tablet: first card across the full width with the picture beside the text, then two by two. */
	@media (max-width: 1024px) {
		.cards {
			grid-template-columns: repeat(2, 1fr);
		}
		.card,
		.card:nth-child(-n + 2) {
			grid-column: span 1;
		}
		.card:first-child {
			grid-column: 1 / -1;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 40px;
			align-items: center;
		}
		.card:first-child .illus {
			margin-bottom: -12px;
		}
	}
	@media (max-width: 600px) {
		.cards {
			grid-template-columns: 1fr;
		}
		.card:first-child {
			display: block;
		}
		.card:first-child .illus {
			margin-bottom: 20px;
		}
		.card {
			padding: 32px 24px;
		}
	}
</style>
