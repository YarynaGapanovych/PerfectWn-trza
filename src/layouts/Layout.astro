---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'PerfectWnętrza — wykończenia i remonty wnętrz',
	description = 'Kompleksowe wykończenia wnętrz i remonty pod klucz w Krakowie i okolicach.',
} = Astro.props;
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#2b2b2b" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&family=Inter:wght@300;400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body id="top">
		<slot />
		<script>
			// "Do góry" and logo links: always scroll to the very top, even when
			// the address already ends in #top (a plain anchor would do nothing then).
			document.querySelectorAll<HTMLAnchorElement>('a[href="#top"]').forEach((link) =>
				link.addEventListener('click', (event) => {
					event.preventDefault();
					window.scrollTo({ top: 0, behavior: 'smooth' });
					history.replaceState(null, '', location.pathname + location.search);
				}),
			);
		</script>
	</body>
</html>
