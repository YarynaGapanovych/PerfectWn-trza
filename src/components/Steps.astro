---
// "Jak to działa" — three numbered steps with icons on a soft sand band. Text comes from the dictionary.
import { getLang, useT } from '../i18n';
import { icons } from '../data/icons';

interface Props {
	/** Which set of steps: renovation, cleaning in general, or short-term rental cleaning. */
	kind: 'renovation' | 'cleaning' | 'rental';
}

const t = useT(getLang(Astro.url)).steps;
const { kind } = Astro.props;
const stepIcons = [icons.message, icons.quote, kind === 'renovation' ? icons.tools : icons.calendarSparkle];
const steps = t[kind].map((s, i) => ({ ...s, icon: stepIcons[i] }));
const { eyebrow, title } = t;
---

<section class="section steps-section">
	<div class="container">
		<span class="eyebrow">{eyebrow}</span>
		<h2 class="section-title">{title}</h2>
		<ol class="steps">
			{
				steps.map((s, i) => (
					<li>
						<div class="step-head">
							<span class="step-icon">
								<svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
							</span>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
						</div>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<style>
	.steps-section {
		background: var(--sand);
	}
	.steps {
		list-style: none;
		margin: 56px 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	.steps li {
		position: relative;
		padding: 36px 32px 40px;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 3px solid var(--accent);
		transition: box-shadow 0.25s, transform 0.25s;
	}
	.steps li:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(43, 43, 43, 0.06);
	}
	/* Arrow between steps on wide screens. */
	.steps li:not(:last-child)::after {
		content: '→';
		position: absolute;
		top: 50%;
		right: -19px;
		transform: translateY(-50%);
		color: var(--accent);
		font-size: 18px;
		line-height: 1;
	}
	.step-head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-bottom: 28px;
	}
	.step-icon {
		display: grid;
		place-items: center;
		width: 60px;
		height: 60px;
		border-radius: 50%;
		background: rgba(164, 137, 106, 0.12);
		color: var(--accent);
	}
	.num {
		font-family: var(--font-serif);
		font-size: 40px;
		font-weight: 300;
		line-height: 1;
		color: rgba(164, 137, 106, 0.35);
	}
	.steps h3 {
		font-size: 20px;
		font-weight: 400;
		margin-bottom: 10px;
	}
	.steps p {
		color: var(--muted);
		font-size: 15px;
	}

	@media (max-width: 900px) {
		.steps {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.steps li:not(:last-child)::after {
			display: none;
		}
	}
</style>
