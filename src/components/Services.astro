---
import { getLang, localize, useT } from '../i18n';

const lang = getLang(Astro.url);
const t = useT(lang).services;
// Illustration per card; titles and texts come from the dictionary (same order).
const images = [
	'/services/wykonczenia.svg',
	'/services/remonty.svg',
	'/services/lazienki-kuchnie.svg',
	'/services/zabudowy.svg',
	'/services/malowanie-podlogi.svg',
	'/services/nadzor.svg',
];
const services = t.cards.map((c, i) => ({ ...c, image: images[i] }));
---

<section class="section services" id="uslugi">
	<div class="container">
		<div class="head">
			<div>
				<span class="eyebrow">{t.eyebrow}</span>
				<h2 class="section-title">{t.titleLines[0]}<br />{t.titleLines[1]}</h2>
			</div>
			<p>{t.intro}</p>
		</div>

		<ol class="grid">
			{
				services.map((s, i) => (
					<li class="card">
						<img class="illus" src={s.image} alt={s.alt} width="779" height="620" loading="lazy" />
						<span class="num">{String(i + 1).padStart(2, '0')}</span>
						<h3>{s.title}</h3>
						<p>{s.text}</p>
					</li>
				))
			}
		</ol>

		<a href={localize('/sprzatanie/', lang)} class="cleaning">
			<span>
				<span class="eyebrow">{t.cleaningEyebrow}</span>
				<strong>{t.cleaningText}</strong>
			</span>
			<span class="cleaning-cta">{t.cleaningCta}</span>
		</a>
	</div>
</section>

<style>
	.services {
		background: var(--surface);
	}
	.head {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: end;
		margin-bottom: 64px;
	}
	.head p {
		color: var(--muted);
		font-weight: 300;
		font-size: 17px;
	}
	.grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.card {
		padding: 40px 36px 44px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		transition: background 0.25s;
	}
	.card:hover {
		background: var(--bg);
	}
	.illus {
		width: calc(100% + 24px);
		max-width: none;
		height: auto;
		margin: -12px -12px 20px;
		transition: transform 0.35s ease;
	}
	.card:hover .illus {
		transform: translateY(-4px);
	}
	.num {
		display: block;
		font-family: var(--font-serif);
		font-size: 18px;
		color: var(--accent);
		margin-bottom: 12px;
	}
	.card h3 {
		font-size: 22px;
		font-weight: 400;
		margin-bottom: 14px;
	}
	.card p {
		color: var(--muted);
		font-size: 15px;
	}

	.cleaning {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px 48px;
		margin-top: 48px;
		padding: 32px 36px;
		background: var(--charcoal);
		color: var(--cream);
		text-decoration: none;
		border-radius: var(--radius);
		transition: background 0.2s;
	}
	.cleaning:hover {
		background: #1f1f1f;
	}
	.cleaning .eyebrow {
		display: block;
		margin-bottom: 8px;
	}
	.cleaning strong {
		font-family: var(--font-serif);
		font-size: 20px;
		font-weight: 300;
	}
	.cleaning-cta {
		flex-shrink: 0;
		font-size: 13px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--bronze);
	}

	@media (max-width: 900px) {
		.cleaning {
			flex-direction: column;
			align-items: flex-start;
		}
		.head {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (max-width: 600px) {
		.grid {
			grid-template-columns: 1fr;
		}
		.card {
			padding: 32px 24px;
		}
		.num {
			margin-bottom: 10px;
		}
	}
</style>
