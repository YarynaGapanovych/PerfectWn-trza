---
import ProjectGrid from './ProjectGrid.astro';
import { getProjects } from '../lib/portfolio';

// Every published project is shown here; hide one with `draft: true` in its .md file.
const projects = await getProjects();
---

<section class="section portfolio" id="realizacje">
	<div class="container">
		<div class="head">
			<div>
				<span class="eyebrow">Realizacje</span>
				<h2 class="section-title">Zobacz, jak<br />pracujemy</h2>
			</div>
			<p>
				Łazienki, kuchnie, mieszkania i lokale użytkowe — wybrane projekty z naszego portfolio.
			</p>
		</div>

		<ProjectGrid projects={projects} />
	</div>
</section>

<style>
	.head {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: end;
		margin-bottom: 64px;
	}
	.head p {
		color: var(--muted);
		font-weight: 300;
		font-size: 17px;
	}
	@media (max-width: 900px) {
		.head {
			grid-template-columns: 1fr;
			gap: 20px;
			margin-bottom: 48px;
		}
	}
</style>
