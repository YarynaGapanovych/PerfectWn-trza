---
// Site header. The site has two sections, Remonty and Sprzątanie, with a switch between them;
// "Usługi" points to the current section's services, and "Realizacje" shows only for renovation
// (there is no cleaning portfolio yet). Service landing pages are linked from the cards and footer.
import { getLang, langs, langLabels, langNames, localize, stripLang, useT } from '../i18n';
import { getServices } from '../lib/services';

const lang = getLang(Astro.url);
const t = useT(lang);
const L = (path: string) => localize(path, lang);
const path = stripLang(Astro.url.pathname);

const services = await getServices(lang);
const isServicePage = (slug: string) => path === `/uslugi/${slug}/`;
const cleaningPages = services.filter((s) => s.data.kind === 'cleaning');

// Which section this page belongs to. Pages in neither (privacy policy) use the renovation menu
// without highlighting a section.
const inCleaning = path === '/sprzatanie/' || cleaningPages.some((s) => isServicePage(s.slug));
const inRenovation = !inCleaning && (path === '/' || path.startsWith('/uslugi/') || path.startsWith('/realizacje/'));
const mode = inCleaning ? 'cleaning' : 'renovation';

// Line icons (viewBox 24): paint roller for renovation, mop for cleaning.
const sections = [
	{
		href: L('/'),
		label: t.nav.renovation,
		active: inRenovation,
		icon: '<rect x="3" y="3" width="14" height="6" rx="1.5"/><path d="M17 6h3v5.5h-8V15"/><rect x="10.5" y="15" width="3" height="6" rx="1"/>',
	},
	{
		href: L('/sprzatanie/'),
		label: t.nav.cleaning,
		active: inCleaning,
		icon: '<path d="M15 2l-3 10"/><path d="M8 12h8l2 9H6Z"/><path d="M10 15.5l-.5 5.5M14 15.5l.5 5.5M12 15.5V21"/>',
	},
];

// The section's list of services: cards on the home page, "Co sprzątamy" on the cleaning page.
const servicesHref = L(mode === 'cleaning' ? '/sprzatanie/#zakres' : '/#uslugi');

// Contact and the quote button go to this section's form: on the page if it has one, else on the section's main page.
const hasForm = path === '/' || path === '/sprzatanie/' || path.startsWith('/uslugi/');
const contactHref = hasForm ? '#kontakt' : L(mode === 'cleaning' ? '/sprzatanie/#kontakt' : '/#kontakt');

// The same page in each language (all languages share the same slugs).
const switcher = langs.map((l) => ({ lang: l, href: localize(Astro.url.pathname, l) }));
---

<header class="header">
	<div class="container header-inner">
		<a href={L('/')} class="logo" aria-label={t.common.home}>
			<img src="/logo.webp" alt="PerfectWnętrza" width="615" height="160" />
		</a>

		<nav class="sections" aria-label={t.nav.sections}>
			{
				sections.map((s) => (
					<a href={s.href} aria-current={s.active ? 'page' : undefined}>
						<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
						{s.label}
					</a>
				))
			}
		</nav>

		<button class="menu-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="main-nav">
			<span></span><span></span>
		</button>

		<nav class="nav" id="main-nav">
			<a href={servicesHref}>{t.nav.services}</a>
			{mode === 'renovation' && <a href={L('/#realizacje')}>{t.nav.projects}</a>}
			<a href={contactHref}>{t.nav.contact}</a>
			<div class="lang">
				<button class="lang-toggle" type="button" aria-expanded="false" aria-controls="lang-menu" aria-label={`${t.common.language}: ${langNames[lang]}`}>
					{langLabels[lang]}
					<svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M2 3.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
				</button>
				<ul class="lang-menu" id="lang-menu" aria-label={t.common.language}>
					{
						switcher.map((s) => (
							<li>
								<a href={s.href} hreflang={s.lang} lang={s.lang} aria-current={s.lang === lang ? 'true' : undefined}>
									<span class="short">{langLabels[s.lang]}</span>
									<span class="full">{langNames[s.lang]}</span>
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('.header');
	const toggle = document.querySelector('.menu-toggle');
	const nav = document.querySelector('.nav');

	const setMenu = (open: boolean) => {
		header?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));

	// Language dropdown (desktop): opens on hover (CSS) and on click/tap or keyboard.
	const langBox = document.querySelector<HTMLElement>('.lang');
	const langToggle = langBox?.querySelector<HTMLButtonElement>('.lang-toggle');
	const setLang = (open: boolean) => langToggle?.setAttribute('aria-expanded', String(open));
	langToggle?.addEventListener('click', () => setLang(langToggle.getAttribute('aria-expanded') !== 'true'));
	document.addEventListener('click', (e) => {
		if (langBox && !langBox.contains(e.target as Node)) setLang(false);
	});

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') {
			setMenu(false);
			setLang(false);
		}
	});
	// Tapping anywhere outside the header closes the open menu.
	document.addEventListener('click', (e) => {
		if (header?.classList.contains('is-open') && !header.contains(e.target as Node)) setMenu(false);
	});

	nav?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => setMenu(false)),
	);

	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--charcoal);
		transition: box-shadow 0.2s;
	}
	.header.is-scrolled {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
	}
	/* Logo on the left; on the right the section switch, then the menu (on tablets: switch and
	   menu button). The header gets more room than page content. */
	.header-inner {
		position: relative;
		max-width: 1320px;
		height: 80px;
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		column-gap: 24px;
	}
	.logo {
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		display: block;
	}
	.logo img {
		height: 46px;
		width: auto;
	}

	/* Section switch: Remonty | Sprzątanie */
	.sections {
		grid-column: 2;
		grid-row: 1;
		display: flex;
		padding: 3px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
	}
	.sections a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		padding: 7px 16px 7px 13px;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		color: var(--silver);
		border-radius: 999px;
		transition: color 0.2s, background 0.2s;
	}
	.sections a:hover {
		color: var(--cream);
	}
	.sections a[aria-current] {
		background: var(--bronze);
		color: #fff;
	}

	.nav {
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.nav a:not(.btn) {
		font: inherit;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		color: var(--silver);
		transition: color 0.2s;
	}
	.nav a:not(.btn):hover {
		color: var(--cream);
	}

	/* Language dropdown: "PL ▾" opening PL / EN / UA */
	.lang {
		position: relative;
		padding-left: 20px;
		border-left: 1px solid rgba(255, 255, 255, 0.15);
	}
	.lang-toggle {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 4px 2px;
		font: inherit;
		font-size: 12px;
		letter-spacing: 0.1em;
		color: var(--bronze);
		background: none;
		border: 0;
		cursor: pointer;
	}
	.lang-toggle svg {
		transition: transform 0.2s;
	}
	.lang-menu {
		position: absolute;
		top: 100%;
		right: -12px;
		min-width: 170px;
		margin: 0;
		padding: 14px 0 0; /* bridges the gap so hover doesn't drop */
		list-style: none;
		visibility: hidden;
		opacity: 0;
		transform: translateY(-4px);
		transition: opacity 0.15s, transform 0.15s, visibility 0.15s;
	}
	.lang-menu li {
		background: var(--charcoal);
	}
	.lang-menu li:first-child {
		padding-top: 6px;
		border-top: 2px solid var(--bronze);
		border-radius: var(--radius) var(--radius) 0 0;
	}
	.lang-menu li:last-child {
		padding-bottom: 6px;
		border-radius: 0 0 var(--radius) var(--radius);
		box-shadow: 0 18px 32px rgba(0, 0, 0, 0.25);
	}
	.nav .lang-menu a {
		display: flex;
		align-items: baseline;
		gap: 12px;
		padding: 8px 16px;
		font-size: 13px;
		letter-spacing: 0.04em;
		text-transform: none;
	}
	.lang-menu .short {
		width: 22px;
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--stone);
	}
	.nav .lang-menu a[aria-current],
	.nav .lang-menu a[aria-current] .short {
		color: var(--bronze);
	}
	.lang:hover .lang-menu,
	.lang:focus-within .lang-menu,
	.lang-toggle[aria-expanded='true'] + .lang-menu {
		visibility: visible;
		opacity: 1;
		transform: none;
	}
	.lang:hover .lang-toggle svg,
	.lang-toggle[aria-expanded='true'] svg {
		transform: rotate(180deg);
	}

	.menu-toggle {
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
		display: none;
		width: 40px;
		height: 40px;
		background: none;
		border: 0;
		cursor: pointer;
		position: relative;
	}
	.menu-toggle span {
		position: absolute;
		left: 9px;
		right: 9px;
		height: 1.5px;
		background: var(--cream);
		transition: transform 0.25s, top 0.25s;
	}
	.menu-toggle span:first-child {
		top: 15px;
	}
	.menu-toggle span:last-child {
		top: 24px;
	}

	/* Below 1024px: the menu moves behind the menu button, next to the switch. */
	@media (max-width: 1024px) {
		.header-inner {
			height: 72px;
		}
		.logo img {
			height: 38px;
		}
		.menu-toggle {
			display: block;
		}
		.header.is-open .menu-toggle span:first-child {
			top: 19px;
			transform: rotate(45deg);
		}
		.header.is-open .menu-toggle span:last-child {
			top: 19px;
			transform: rotate(-45deg);
		}

		.nav {
			/* Auto placement: an absolutely-positioned grid item then spans the whole header
			   (with a column set it would only cover that column). */
			grid-column: auto;
			grid-row: auto;
			justify-self: stretch;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin: 0;
			padding: 8px 24px 24px;
			background: var(--charcoal);
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			display: none;
			max-height: calc(100vh - 140px);
			overflow-y: auto;
		}
		.header.is-open .nav {
			display: flex;
		}
		.nav > a:not(.btn) {
			padding: 14px 0;
		}

		/* In the menu the languages are shown as three buttons, not a dropdown. */
		.lang {
			order: 10;
			padding: 16px 0 0;
			border-left: 0;
		}
		.lang-toggle {
			display: none;
		}
		.lang-menu {
			position: static;
			display: flex;
			gap: 8px;
			min-width: 0;
			padding: 0;
			visibility: visible;
			opacity: 1;
			transform: none;
		}
		.lang-menu li,
		.lang-menu li:first-child,
		.lang-menu li:last-child {
			padding: 0;
			border: 0;
			border-radius: 0;
			box-shadow: none;
			background: none;
		}
		.nav .lang-menu a {
			padding: 8px 14px;
			font-size: 12px;
			letter-spacing: 0.1em;
			border: 1px solid rgba(255, 255, 255, 0.15);
			border-radius: var(--radius);
		}
		.lang-menu .full {
			display: none;
		}
		.lang-menu .short {
			width: auto;
			font-size: inherit;
			color: inherit;
		}
	}
	@media (max-width: 720px) {
		.nav {
			padding-left: 16px;
			padding-right: 16px;
		}
	}
	/* Phones: logo, switch and menu button don't fit on one line, so the switch gets its own
	   full-width row, still visible without opening the menu. */
	@media (max-width: 500px) {
		.header-inner {
			height: auto;
			grid-template-columns: 1fr auto;
			padding-top: 14px;
			padding-bottom: 12px;
		}
		.menu-toggle {
			grid-column: 2;
		}
		.sections {
			grid-column: 1 / -1;
			grid-row: 2;
			margin-top: 12px;
		}
		.sections a {
			flex: 1;
			text-align: center;
			padding: 9px 12px;
		}
	}
</style>
