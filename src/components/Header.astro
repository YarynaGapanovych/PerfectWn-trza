---
// Site header. The site has two sections, Remonty and Sprzątanie, with a switch between them;
// "Usługi" points to the current section's services, and "Realizacje" shows only for renovation
// (there is no cleaning portfolio yet). Service landing pages are linked from the cards and footer.
import { getLang, langs, langLabels, langNames, localize, stripLang, useT } from '../i18n';
import { getServices } from '../lib/services';

const lang = getLang(Astro.url);
const t = useT(lang);
const L = (path: string) => localize(path, lang);
const path = stripLang(Astro.url.pathname);

const services = await getServices(lang);
const isServicePage = (slug: string) => path === `/uslugi/${slug}/`;
const cleaningPages = services.filter((s) => s.data.kind === 'cleaning');

// Which section this page belongs to. Pages in neither (privacy policy) use the renovation menu
// without highlighting a section.
const inCleaning = path === '/sprzatanie/' || cleaningPages.some((s) => isServicePage(s.slug));
const inRenovation = !inCleaning && (path === '/' || path.startsWith('/uslugi/') || path.startsWith('/realizacje/'));
const mode = inCleaning ? 'cleaning' : 'renovation';

// Line icons (viewBox 24): paint roller for renovation, mop for cleaning.
const sections = [
	{
		href: L('/'),
		label: t.nav.renovation,
		active: inRenovation,
		icon: '<rect x="3" y="3" width="14" height="6" rx="1.5"/><path d="M17 6h3v5.5h-8V15"/><rect x="10.5" y="15" width="3" height="6" rx="1"/>',
	},
	{
		href: L('/sprzatanie/'),
		label: t.nav.cleaning,
		active: inCleaning,
		icon: '<path d="M15 2l-3 10"/><path d="M8 12h8l2 9H6Z"/><path d="M10 15.5l-.5 5.5M14 15.5l.5 5.5M12 15.5V21"/>',
	},
];

// The section's list of services: cards on the home page, "Co sprzątamy" on the cleaning page.
const servicesHref = L(mode === 'cleaning' ? '/sprzatanie/#zakres' : '/#uslugi');

// Contact and the quote button go to this section's form: on the page if it has one, else on the section's main page.
const hasForm = path === '/' || path === '/sprzatanie/' || path.startsWith('/uslugi/');
const contactHref = hasForm ? '#kontakt' : L(mode === 'cleaning' ? '/sprzatanie/#kontakt' : '/#kontakt');

// The same page in each language (all languages share the same slugs).
const switcher = langs.map((l) => ({ lang: l, href: localize(Astro.url.pathname, l) }));
---

<header class="header">
	<div class="container header-inner">
		<a href={L('/')} class="logo" aria-label={t.common.home}>
			<img src="/logo.webp" alt="PerfectWnętrza" width="615" height="160" />
		</a>

		<nav class="sections" aria-label={t.nav.sections}>
			{
				sections.map((s) => (
					<a href={s.href} aria-current={s.active ? 'page' : undefined}>
						<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
						{s.label}
					</a>
				))
			}
		</nav>

		<button class="menu-toggle" aria-label={t.nav.openMenu} aria-expanded="false" aria-controls="main-nav">
			<span></span><span></span>
		</button>

		<nav class="nav" id="main-nav">
			<a href={servicesHref}>{t.nav.services}</a>
			{mode === 'renovation' && <a href={L('/#realizacje')}>{t.nav.projects}</a>}
			<a href={contactHref}>{t.nav.contact}</a>
			<div class="lang" role="group" aria-label={t.common.language}>
				{
					switcher.map((s) => (
						<a href={s.href} hreflang={s.lang} lang={s.lang} aria-label={langNames[s.lang]} aria-current={s.lang === lang ? 'true' : undefined}>
							{langLabels[s.lang]}
						</a>
					))
				}
			</div>
		</nav>
	</div>
</header>

<script>
	const header = document.querySelector('.header');
	const toggle = document.querySelector('.menu-toggle');
	const nav = document.querySelector('.nav');

	const setMenu = (open: boolean) => {
		header?.classList.toggle('is-open', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};

	toggle?.addEventListener('click', () => setMenu(!header?.classList.contains('is-open')));

	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape') setMenu(false);
	});
	// Tapping anywhere outside the header closes the open menu.
	document.addEventListener('click', (e) => {
		if (header?.classList.contains('is-open') && !header.contains(e.target as Node)) setMenu(false);
	});

	nav?.querySelectorAll('a').forEach((a) =>
		a.addEventListener('click', () => setMenu(false)),
	);

	const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 10);
	window.addEventListener('scroll', onScroll, { passive: true });
	onScroll();
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--charcoal);
		transition: box-shadow 0.2s;
	}
	.header.is-scrolled {
		box-shadow: 0 6px 24px rgba(0, 0, 0, 0.18);
	}
	/* Logo on the left; menu and the section switch on the right (on tablets: switch and menu
	   button). The header gets more room than page content. */
	.header-inner {
		position: relative;
		max-width: 1320px;
		height: 80px;
		display: grid;
		grid-template-columns: 1fr auto auto;
		align-items: center;
		column-gap: 24px;
	}
	.logo {
		grid-column: 1;
		grid-row: 1;
		justify-self: start;
		display: block;
	}
	.logo img {
		height: 46px;
		width: auto;
	}

	/* Section switch: Remonty | Sprzątanie */
	.sections {
		grid-column: 3;
		grid-row: 1;
		display: flex;
		padding: 3px;
		border: 1px solid rgba(255, 255, 255, 0.18);
		border-radius: 999px;
	}
	.sections a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 7px;
		padding: 7px 16px 7px 13px;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		color: var(--silver);
		border-radius: 999px;
		transition: color 0.2s, background 0.2s;
	}
	.sections a:hover {
		color: var(--cream);
	}
	.sections a[aria-current] {
		background: var(--bronze);
		color: #fff;
	}

	.nav {
		grid-column: 2;
		grid-row: 1;
		justify-self: end;
		display: flex;
		align-items: center;
		gap: 24px;
	}
	.nav a:not(.btn) {
		font: inherit;
		font-size: 14px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		text-decoration: none;
		white-space: nowrap;
		color: var(--silver);
		transition: color 0.2s;
	}
	.nav a:not(.btn):hover {
		color: var(--cream);
	}

	/* Language switcher: PL · EN · UA */
	.nav .lang {
		display: flex;
		gap: 2px;
		padding-left: 20px;
		border-left: 1px solid rgba(255, 255, 255, 0.15);
	}
	.nav .lang a {
		padding: 4px 6px;
		font-size: 12px;
		letter-spacing: 0.1em;
		border-radius: var(--radius);
	}
	.nav .lang a[aria-current] {
		color: var(--bronze);
	}

	.menu-toggle {
		grid-column: 3;
		grid-row: 1;
		justify-self: end;
		display: none;
		width: 40px;
		height: 40px;
		background: none;
		border: 0;
		cursor: pointer;
		position: relative;
	}
	.menu-toggle span {
		position: absolute;
		left: 9px;
		right: 9px;
		height: 1.5px;
		background: var(--cream);
		transition: transform 0.25s, top 0.25s;
	}
	.menu-toggle span:first-child {
		top: 15px;
	}
	.menu-toggle span:last-child {
		top: 24px;
	}

	/* Below 1240px: the menu moves behind the menu button, next to the switch. */
	@media (max-width: 1240px) {
		.sections {
			grid-column: 2;
		}
		.header-inner {
			height: 72px;
		}
		.logo img {
			height: 38px;
		}
		.menu-toggle {
			display: block;
		}
		.header.is-open .menu-toggle span:first-child {
			top: 19px;
			transform: rotate(45deg);
		}
		.header.is-open .menu-toggle span:last-child {
			top: 19px;
			transform: rotate(-45deg);
		}

		.nav {
			/* Auto placement: an absolutely-positioned grid item then spans the whole header
			   (with a column set it would only cover that column). */
			grid-column: auto;
			grid-row: auto;
			justify-self: stretch;
			position: absolute;
			top: 100%;
			left: 0;
			right: 0;
			flex-direction: column;
			align-items: stretch;
			gap: 0;
			margin: 0;
			padding: 8px 24px 24px;
			background: var(--charcoal);
			border-top: 1px solid rgba(255, 255, 255, 0.08);
			display: none;
			max-height: calc(100vh - 140px);
			overflow-y: auto;
		}
		.header.is-open .nav {
			display: flex;
		}
		.nav > a:not(.btn) {
			padding: 14px 0;
		}

		.nav .lang {
			order: 10;
			padding: 16px 0 0;
			border-left: 0;
			gap: 8px;
		}
		.nav .lang a {
			padding: 8px 14px;
			border: 1px solid rgba(255, 255, 255, 0.15);
		}
	}
	@media (max-width: 720px) {
		.nav {
			padding-left: 16px;
			padding-right: 16px;
		}
	}
	/* Phones: logo, switch and menu button don't fit on one line, so the switch gets its own
	   full-width row, still visible without opening the menu. */
	@media (max-width: 500px) {
		.header-inner {
			height: auto;
			grid-template-columns: 1fr auto;
			padding-top: 14px;
			padding-bottom: 12px;
		}
		.menu-toggle {
			grid-column: 2;
		}
		.sections {
			grid-column: 1 / -1;
			grid-row: 2;
			margin-top: 12px;
		}
		.sections a {
			flex: 1;
			text-align: center;
			padding: 9px 12px;
		}
	}
</style>
