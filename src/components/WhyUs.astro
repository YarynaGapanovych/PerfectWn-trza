---
// "Dlaczego my" — reasons to choose PerfectWnętrza. Only promises the site already makes elsewhere;
// add a guarantee or other points here once they are confirmed.
import { icons } from '../data/icons';
import { getLang, useT } from '../i18n';

const t = useT(getLang(Astro.url)).why;
const reasonIcons = [icons.quote, icons.person, icons.calendarSparkle, icons.clock, icons.sparkle, icons.shield];
const reasons = t.reasons.map((r, i) => ({ ...r, icon: reasonIcons[i] }));
---

<section class="section why">
	<div class="container">
		<div class="head">
			<div>
				<span class="eyebrow">{t.eyebrow}</span>
				<h2 class="section-title">{t.titleLines[0]}<br />{t.titleLines[1]}</h2>
			</div>
			<p>{t.intro}</p>
		</div>
		<ul class="reasons">
			{
				reasons.map((r) => (
					<li>
						<span class="icon">
							<svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={r.icon} />
						</span>
						<h3>{r.title}</h3>
						<p>{r.text}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.why {
		background: var(--sand);
	}
	.head {
		display: grid;
		grid-template-columns: 1.2fr 1fr;
		gap: 48px;
		align-items: end;
		margin-bottom: 56px;
	}
	.head p {
		color: var(--muted);
		font-weight: 300;
		font-size: 17px;
	}
	.reasons {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}
	.reasons li {
		padding: 32px 30px 36px;
		background: var(--surface);
		border: 1px solid var(--line);
		transition: box-shadow 0.25s, transform 0.25s;
	}
	.reasons li:hover {
		transform: translateY(-4px);
		box-shadow: 0 12px 28px rgba(43, 43, 43, 0.06);
	}
	.icon {
		display: grid;
		place-items: center;
		width: 54px;
		height: 54px;
		margin-bottom: 22px;
		border-radius: 50%;
		background: rgba(164, 137, 106, 0.12);
		color: var(--accent);
	}
	.reasons h3 {
		font-size: 19px;
		font-weight: 400;
		margin-bottom: 10px;
	}
	.reasons p {
		color: var(--muted);
		font-size: 15px;
	}
	@media (max-width: 900px) {
		.head {
			grid-template-columns: 1fr;
			gap: 20px;
		}
		.reasons {
			grid-template-columns: 1fr 1fr;
		}
	}
	@media (max-width: 600px) {
		.reasons {
			grid-template-columns: 1fr;
		}
	}
</style>
