---
const stats = [
	{ value: '10+', label: 'lat doświadczenia' },
	{ value: '250+', label: 'wykończonych wnętrz' },
	{ value: '100%', label: 'terminowych realizacji' },
];
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<span class="eyebrow">Wykończenia wnętrz pod klucz</span>
			<h1>Wnętrza dopracowane <em>w każdym detalu</em></h1>
			<p class="lead">
				Projektujemy, remontujemy i wykańczamy mieszkania, domy oraz lokale usługowe.
				Jeden zespół, jeden harmonogram i pełna odpowiedzialność za efekt.
			</p>
			<div class="actions">
				<a href="#kontakt" class="btn btn-primary">Umów konsultację</a>
				<a href="#uslugi" class="btn btn-ghost">Zobacz usługi</a>
			</div>

			<dl class="stats">
				{
					stats.map((s) => (
						<div>
							<dt>{s.value}</dt>
							<dd>{s.label}</dd>
						</div>
					))
				}
			</dl>
		</div>

		<div class="hero-visual" aria-hidden="true">
			<div class="mosaic">
				<div class="b b1"></div>
				<div class="b b2"></div>
				<div class="b b3"></div>
				<div class="b b4"><span></span></div>
				<div class="b b5"></div>
				<div class="b b6"></div>
				<div class="b b7"></div>
			</div>
			<div class="badge">
				<span>Od projektu</span>
				<strong>do odbioru kluczy</strong>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		padding: 72px 0 112px;
		overflow: hidden;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 64px;
		align-items: center;
	}
	h1 {
		font-size: clamp(36px, 5vw, 62px);
		letter-spacing: -0.015em;
	}
	h1 em {
		color: var(--accent);
		font-style: normal;
		font-weight: 400;
	}
	.lead {
		margin-top: 28px;
		max-width: 500px;
		font-size: 18px;
		color: var(--muted);
		font-weight: 300;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 40px;
	}
	.stats {
		display: grid;
		grid-template-columns: repeat(3, auto);
		justify-content: start;
		gap: 48px;
		margin: 56px 0 0;
		padding-top: 32px;
		border-top: 1px solid var(--line);
	}
	.stats dt {
		font-family: var(--font-serif);
		font-size: 34px;
		line-height: 1;
	}
	.stats dd {
		margin: 8px 0 0;
		font-size: 13px;
		color: var(--muted);
	}

	.hero-visual {
		position: relative;
		height: 600px;
	}
	/* Block composition echoing the brand sheet */
	.mosaic {
		position: absolute;
		inset: 0 0 40px 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		grid-template-rows: repeat(5, 1fr);
	}
	.b1 {
		grid-area: 1 / 1 / 3 / 3;
		background: var(--mist);
	}
	.b2 {
		grid-area: 1 / 3 / 2 / 5;
		background: var(--stone);
	}
	.b3 {
		grid-area: 3 / 1 / 6 / 2;
		background: var(--surface);
	}
	.b4 {
		grid-area: 2 / 3 / 4 / 5;
		background: var(--charcoal);
		position: relative;
	}
	.b4 span {
		position: absolute;
		left: 18%;
		top: 30%;
		width: 16%;
		aspect-ratio: 1;
		background: var(--stone);
	}
	.b5 {
		grid-area: 3 / 2 / 6 / 3;
		background: var(--silver);
	}
	.b6 {
		grid-area: 4 / 3 / 6 / 4;
		background: var(--bronze);
	}
	.b7 {
		grid-area: 4 / 4 / 6 / 5;
		background: #8f8b85;
	}
	.badge {
		position: absolute;
		right: -10px;
		bottom: 100px;
		background: var(--surface);
		padding: 20px 26px;
		box-shadow: 0 18px 40px rgba(31, 27, 23, 0.12);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
	}
	.badge span {
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.badge strong {
		font-family: var(--font-serif);
		font-size: 18px;
		font-weight: 400;
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		.hero-visual {
			height: 420px;
		}
		.badge {
			right: 12px;
		}
	}
	@media (max-width: 520px) {
		.hero {
			padding: 40px 0 80px;
		}
		.stats {
			gap: 24px;
		}
		.stats dt {
			font-size: 32px;
		}
		.hero-visual {
			height: 340px;
		}
		.stats dd {
			font-size: 12px;
		}
	}
</style>
