---
import Stats from './Stats.astro';
import { getLang, useT } from '../i18n';

const t = useT(getLang(Astro.url)).hero;
---

<section class="hero">
	<div class="container hero-grid">
		<div class="hero-copy">
			<span class="eyebrow">{t.eyebrow}</span>
			<h1>{t.title} <em>{t.titleAccent}</em></h1>
			<p class="lead">{t.lead}</p>
			<div class="actions">
				<a href="#kontakt" class="btn btn-primary">{t.primary}</a>
				<a href="#uslugi" class="btn btn-ghost">{t.secondary}</a>
			</div>
			<Stats />
		</div>

		<div class="hero-visual">
			<img
				class="flat"
				src="/flat.svg"
				alt={t.alt}
				width="779"
				height="620"
				fetchpriority="high"
			/>
			<div class="badge" aria-hidden="true">
				<span>{t.badgeSmall}</span>
				<strong>{t.badgeBig}</strong>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		/* Fills the screen below the header, content centred vertically. */
		min-height: calc(100vh - var(--header-h));
		min-height: calc(100svh - var(--header-h));
		display: flex;
		align-items: center;
		padding: 56px 0 72px;
		overflow: hidden;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: 1.05fr 1fr;
		gap: 64px;
		align-items: center;
	}
	h1 {
		font-size: clamp(36px, 5vw, 62px);
		letter-spacing: -0.015em;
	}
	h1 em {
		color: var(--accent);
		font-style: normal;
		font-weight: 400;
	}
	.lead {
		margin-top: 28px;
		max-width: 500px;
		font-size: 18px;
		color: var(--muted);
		font-weight: 300;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 40px;
	}
	.hero-visual {
		position: relative;
	}
	.flat {
		width: 112%;
		max-width: none;
		height: auto;
		margin-left: -4%;
	}
	.badge {
		position: absolute;
		left: 0;
		bottom: 2%;
		background: var(--surface);
		padding: 20px 26px;
		box-shadow: 0 18px 40px rgba(31, 27, 23, 0.12);
		border-radius: var(--radius);
		display: flex;
		flex-direction: column;
	}
	.badge span {
		font-size: 12px;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.badge strong {
		font-family: var(--font-serif);
		font-size: 18px;
		font-weight: 400;
	}

	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}
		.flat {
			width: 100%;
			margin-left: 0;
		}
		.badge {
			position: static;
			display: inline-flex;
			margin-top: 8px;
		}
	}
	@media (max-width: 520px) {
		.hero {
			padding: 40px 0 80px;
		}
		.badge {
			padding: 14px 18px;
		}
	}
</style>
