---
// Custom dropdown in the site's style. Submits its value through a hidden input,
// so it works in forms like a native <select>.
interface Props {
	name: string;
	label: string;
	options: string[];
	value?: string;
}

const { name, label, options, value = options[0] } = Astro.props;
const id = `select-${name}`;
---

<div class="select" data-select>
	<span class="select-label" id={`${id}-label`}>{label}</span>
	<input type="hidden" name={name} value={value} />

	<button
		type="button"
		class="select-trigger"
		id={`${id}-trigger`}
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-controls={`${id}-list`}
		aria-labelledby={`${id}-label ${id}-trigger`}
	>
		<span class="select-value">{value}</span>
		<svg class="select-chevron" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
			<path d="M3 5.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
	</button>

	<ul class="select-list" id={`${id}-list`} role="listbox" aria-labelledby={`${id}-label`} tabindex="-1" hidden>
		{
			options.map((opt, i) => (
				<li
					class="select-option"
					id={`${id}-opt-${i}`}
					role="option"
					data-value={opt}
					aria-selected={opt === value ? 'true' : 'false'}
				>
					<span>{opt}</span>
					<svg class="select-check" width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
						<path d="M2.5 7.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
					</svg>
				</li>
			))
		}
	</ul>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-select]').forEach((root) => {
		const input = root.querySelector<HTMLInputElement>('input[type="hidden"]')!;
		const trigger = root.querySelector<HTMLButtonElement>('.select-trigger')!;
		const valueEl = root.querySelector<HTMLElement>('.select-value')!;
		const list = root.querySelector<HTMLUListElement>('.select-list')!;
		const options = [...root.querySelectorAll<HTMLLIElement>('.select-option')];
		let active = Math.max(0, options.findIndex((o) => o.getAttribute('aria-selected') === 'true'));

		const setActive = (i: number) => {
			active = (i + options.length) % options.length;
			options.forEach((o, j) => o.classList.toggle('is-active', j === active));
			list.setAttribute('aria-activedescendant', options[active].id);
			options[active].scrollIntoView({ block: 'nearest' });
		};

		const open = () => {
			if (!list.hidden) return;
			list.hidden = false;
			root.classList.add('is-open');
			trigger.setAttribute('aria-expanded', 'true');
			setActive(options.findIndex((o) => o.getAttribute('aria-selected') === 'true'));
			list.focus();
		};

		const close = (focusTrigger = true) => {
			if (list.hidden) return;
			list.hidden = true;
			root.classList.remove('is-open');
			trigger.setAttribute('aria-expanded', 'false');
			if (focusTrigger) trigger.focus();
		};

		const choose = (i: number) => {
			options.forEach((o, j) => o.setAttribute('aria-selected', String(j === i)));
			input.value = options[i].dataset.value ?? '';
			valueEl.textContent = input.value;
			input.dispatchEvent(new Event('change', { bubbles: true }));
			close();
		};

		trigger.addEventListener('click', () => (list.hidden ? open() : close()));
		trigger.addEventListener('keydown', (e) => {
			if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
				e.preventDefault();
				open();
			}
		});

		list.addEventListener('keydown', (e) => {
			switch (e.key) {
				case 'ArrowDown':
					e.preventDefault();
					setActive(active + 1);
					break;
				case 'ArrowUp':
					e.preventDefault();
					setActive(active - 1);
					break;
				case 'Home':
					e.preventDefault();
					setActive(0);
					break;
				case 'End':
					e.preventDefault();
					setActive(options.length - 1);
					break;
				case 'Enter':
				case ' ':
					e.preventDefault();
					choose(active);
					break;
				case 'Escape':
					e.preventDefault();
					close();
					break;
				case 'Tab':
					close(false);
					break;
				default:
					// type-ahead: jump to the first option starting with the typed letter
					if (e.key.length === 1) {
						const k = e.key.toLowerCase();
						const i = options.findIndex((o, j) => j > active && o.textContent!.trim().toLowerCase().startsWith(k));
						const first = options.findIndex((o) => o.textContent!.trim().toLowerCase().startsWith(k));
						if (i >= 0 || first >= 0) setActive(i >= 0 ? i : first);
					}
			}
		});

		options.forEach((o, i) => {
			o.addEventListener('mousemove', () => active !== i && setActive(i));
			o.addEventListener('click', () => choose(i));
		});

		document.addEventListener('pointerdown', (e) => {
			if (!root.contains(e.target as Node)) close(false);
		});
	});
</script>

<style>
	.select {
		position: relative;
		display: grid;
		gap: 8px;
	}
	.select-label {
		font-size: 13px;
		color: var(--muted);
	}
	.select-trigger {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		width: 100%;
		padding: 10px 0;
		font: inherit;
		font-size: 15px;
		color: var(--ink);
		text-align: left;
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--line);
		border-radius: 0;
		cursor: pointer;
		transition: border-color 0.2s;
	}
	.select-trigger:hover,
	.select-trigger:focus-visible,
	.is-open .select-trigger {
		outline: none;
		border-bottom-color: var(--accent);
	}
	.select-chevron {
		flex: none;
		color: var(--accent);
		transition: transform 0.2s;
	}
	.is-open .select-chevron {
		transform: rotate(180deg);
	}

	.select-list {
		position: absolute;
		top: calc(100% + 6px);
		left: 0;
		right: 0;
		z-index: 20;
		margin: 0;
		padding: 6px;
		list-style: none;
		background: var(--surface);
		border: 1px solid var(--line);
		border-top: 2px solid var(--accent);
		border-radius: var(--radius);
		box-shadow: 0 18px 40px rgba(43, 43, 43, 0.12);
		max-height: 340px;
		overflow-y: auto;
		outline: none;
		animation: select-in 0.16s ease-out;
	}
	@keyframes select-in {
		from {
			opacity: 0;
			transform: translateY(-4px);
		}
	}
	.select-option {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 12px;
		padding: 11px 14px;
		font-size: 15px;
		color: var(--ink);
		border-radius: var(--radius);
		cursor: pointer;
	}
	.select-option.is-active {
		background: var(--bg);
	}
	.select-option[aria-selected='true'] {
		color: var(--accent-dark);
		font-weight: 500;
	}
	.select-check {
		flex: none;
		color: var(--accent);
		visibility: hidden;
	}
	.select-option[aria-selected='true'] .select-check {
		visibility: visible;
	}
	.select-list:focus-visible .select-option.is-active {
		box-shadow: inset 0 0 0 1px var(--accent);
	}
</style>
