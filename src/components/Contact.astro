---
import Select from './Select.astro';
import { site, telHref, whatsappHref } from '../data/site';
import { getLang, langNames, localize, useT } from '../i18n';

interface Props {
	/** Which form: renovation (home and renovation pages) or cleaning (cleaning pages). */
	kind?: 'renovation' | 'cleaning';
	/** Option pre-selected in the first dropdown — one of SERVICE_VALUES or CLEANING_VALUES (Polish). */
	service?: string;
}

const lang = getLang(Astro.url);
const t = useT(lang);
const c = t.contact;

// Values sent to the inbox stay in Polish; visitors see them in their language (same order
// as the dictionary lists).
const SERVICE_VALUES = ['Wykończenie pod klucz', 'Malowanie i podłogi', 'Remont / modernizacja', 'Łazienka lub kuchnia', 'Zabudowy i stolarka', 'Inne'];
const CLEANING_VALUES = [
	'Klatka schodowa',
	'Sprzątanie po remoncie',
	'Biuro lub lokal komercyjny',
	'Szkoła lub obiekt publiczny',
	'Mieszkanie na wynajem krótkoterminowy',
	'Inne',
];
const FREQUENCY_VALUES = ['Jednorazowo', 'Regularnie', 'Jeszcze nie wiem'];

const { kind = 'renovation' } = Astro.props;
const cleaning = kind === 'cleaning';
const cl = c.cleaning;
const options = (values: string[], labels: string[]) => values.map((value, i) => ({ value, label: labels[i] }));

// The first dropdown: type of work for renovation, type of place for cleaning.
const first = cleaning
	? { name: 'Rodzaj obiektu', label: cl.objectType, values: CLEANING_VALUES, labels: cl.objectTypes }
	: { name: 'Rodzaj prac', label: c.workType, values: SERVICE_VALUES, labels: c.workTypes };
const selected = first.values.includes(Astro.props.service ?? '') ? Astro.props.service : first.values[0];
// Separate subjects so the two kinds of enquiry are easy to tell apart in the inbox.
const subject = cleaning ? 'Nowe zapytanie — sprzątanie | PerfectWnętrza' : 'Nowe zapytanie — remont | PerfectWnętrza';

const contactWays = ['Telefon', 'E-mail', ...(whatsappHref ? ['WhatsApp'] : [])].map((value) => ({ value, label: c.contactWays[value] }));

// Web3Forms delivers submissions to all.perfectwnetrza@gmail.com (key is tied to that inbox).
// Set PUBLIC_WEB3FORMS_KEY in .env locally and in Vercel's environment variables.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---

<section class="section contact" id="kontakt">
	<div class="container grid">
		<div class="info">
			<span class="eyebrow">{c.eyebrow}</span>
			<h2 class="section-title">{cleaning ? cl.title : c.title}</h2>
			<p class="intro">{cleaning ? cl.intro : c.intro}</p>

			<dl class="details">
				<div>
					<dt>{c.phone}</dt>
					<dd><a href={telHref}>{site.phone}</a></dd>
				</div>
				{
					whatsappHref && (
						<div>
							<dt>{c.whatsapp}</dt>
							<dd>
								<a href={whatsappHref} target="_blank" rel="noopener">{c.whatsappLink}</a>
							</dd>
						</div>
					)
				}
				<div>
					<dt>{c.email}</dt>
					<dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
				</div>
				<div>
					<dt>{c.address}</dt>
					<dd>{t.common.area}</dd>
				</div>
				<div>
					<dt>{c.hours}</dt>
					<dd>{t.common.hours}</dd>
				</div>
			</dl>
		</div>

		<form
			class="form"
			method="post"
			action="https://api.web3forms.com/submit"
			data-contact-form
			data-kind={kind}
			data-phone={site.phone}
			data-email={site.email}
			data-sending={c.sending}
			data-success={c.success}
			data-error={c.errorBefore}
			data-or={c.or}
		>
			<input type="hidden" name="access_key" value={formKey ?? ''} />
			<input type="hidden" name="subject" value={subject} />
			<input type="hidden" name="Formularz" value={cleaning ? 'Sprzątanie' : 'Remont'} />
			<input type="hidden" name="from_name" value="PerfectWnętrza — formularz" />
			<!-- Tells you which language version the enquiry came from. -->
			<input type="hidden" name="Język strony" value={langNames[lang]} />
			<!-- Honeypot: hidden from people, bots tick it and get filtered out. -->
			<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

			{
				!formKey && (
					<p class="form-status is-error" role="status">
						{c.unavailableBefore} <a href={telHref}>{site.phone}</a> {c.or} <a href={`mailto:${site.email}`}>{site.email}</a>.
					</p>
				)
			}

			<div class="row">
				<label>
					<span>{c.name}</span>
					<input type="text" name="name" autocomplete="name" required />
				</label>
				<label>
					<span>{c.phone}</span>
					<input type="tel" name="Telefon" autocomplete="tel" />
				</label>
			</div>
			<label>
				<span>{c.email}</span>
				<input type="email" name="email" autocomplete="email" required />
			</label>
			<Select name={first.name} label={first.label} options={options(first.values, first.labels)} value={selected} />
			{cleaning && <Select name="Częstotliwość" label={cl.frequency} options={options(FREQUENCY_VALUES, cl.frequencies)} />}
			<label>
				<span>{c.message}</span>
				<textarea name="Wiadomość" rows="5" placeholder={cleaning ? cl.messagePlaceholder : c.messagePlaceholder} required></textarea>
			</label>
			<Select name="Preferowany kontakt" label={c.contactWay} options={contactWays} value="Telefon" />
			{!cleaning && <p class="hint">
				{c.hintBefore} <a href={`mailto:${site.email}`}>{site.email}</a>{whatsappHref && <> {c.hintOr} <a href={whatsappHref} target="_blank" rel="noopener">WhatsApp</a></>} {c.hintAfter}
			</p>}
			<button type="submit" class="btn btn-primary" disabled={!formKey}>{c.submit}</button>
			<p class="note">
				{c.noteBefore} <a href={localize('/polityka-prywatnosci/', lang)}>{c.noteLink}</a>.
			</p>
			<p class="form-status" role="status" aria-live="polite" hidden></p>
		</form>
	</div>
</section>

<script>
	// Send the form in the background and show the result inside the form.
	// Without JavaScript the form still posts normally to Web3Forms.
	document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const status = form.querySelector<HTMLElement>('.form-status[aria-live]')!;
		const label = button.textContent;
		const { phone = '', email = '', sending = '', success = '', error = '', or = '' } = form.dataset;

		const show = (kind: 'success' | 'error', html: string) => {
			status.hidden = false;
			status.className = `form-status is-${kind}`;
			status.innerHTML = html;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			button.textContent = sending;
			status.hidden = true;

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: new FormData(form),
				});
				const result = await response.json().catch(() => ({}));
				if (!response.ok || !result.success) throw new Error(result.message || response.statusText);

				form.reset();
				// Analytics: count successful enquiries (no-op without analytics).
				(window as unknown as { plausible?: (e: string, o?: object) => void }).plausible?.('Formularz', {
					props: { page: location.pathname, form: form.dataset.kind ?? '' },
				});
				show('success', success);
			} catch (error) {
				console.error('Contact form error:', error);
				show(
					'error',
					`${error} ` +
						`<a href="tel:${phone.replace(/\s/g, '')}">${phone}</a> ${or} ` +
						`<a href="mailto:${email}">${email}</a>.`,
				);
			} finally {
				button.disabled = false;
				button.textContent = label;
			}
		});
	});
</script>

<style>
	.grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 80px;
		align-items: start;
	}
	.intro {
		margin-top: 24px;
		color: var(--muted);
		font-weight: 300;
		font-size: 17px;
		max-width: 440px;
	}
	.details {
		margin: 48px 0 0;
		display: grid;
		gap: 24px;
	}
	.details dt {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.details dd {
		margin: 4px 0 0;
		font-family: var(--font-serif);
		font-size: 19px;
	}
	.details a {
		text-decoration: none;
	}
	.details a:hover {
		color: var(--accent);
	}

	.form {
		background: var(--surface);
		padding: 48px;
		border-radius: var(--radius);
		display: grid;
		gap: 22px;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 22px;
	}
	label {
		display: grid;
		gap: 8px;
	}
	label span {
		font-size: 13px;
		color: var(--muted);
	}
	input,
	select,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 15px;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--line);
		padding: 10px 0;
		border-radius: 0;
		transition: border-color 0.2s;
	}
	textarea {
		resize: vertical;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}
	.form .btn {
		justify-self: start;
		margin-top: 8px;
	}
	.form .btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.botcheck {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.note {
		margin-top: -8px;
		font-size: 12px;
		color: var(--muted);
	}
	.note a,
	.hint a {
		color: inherit;
	}
	.hint {
		margin-top: -6px;
		font-size: 13px;
		color: var(--muted);
	}
	.form-status {
		padding: 14px 16px;
		font-size: 14px;
		line-height: 1.5;
		border-left: 3px solid;
		border-radius: var(--radius);
	}
	.form-status.is-success {
		color: var(--ink);
		background: var(--cream);
		border-color: var(--accent);
	}
	.form-status.is-error {
		color: #8a2f25;
		background: #fbeeec;
		border-color: #b5483b;
	}
	.form-status a {
		color: inherit;
		font-weight: 500;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}
	@media (max-width: 520px) {
		.form {
			padding: 28px 20px;
		}
		.row {
			grid-template-columns: 1fr;
		}
		.form .btn {
			justify-self: stretch;
			justify-content: center;
		}
	}
</style>
