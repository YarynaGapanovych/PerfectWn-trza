---
import Select from './Select.astro';

interface Props {
	/** Option pre-selected in "Rodzaj prac" (must match one of the options). */
	service?: string;
}

const services = [
	'Wykończenie pod klucz',
	'Malowanie i podłogi',
	'Remont / modernizacja',
	'Łazienka lub kuchnia',
	'Zabudowy i stolarka',
	'Sprzątanie',
	'Inne',
];
const { service = services[0] } = Astro.props;

const contact = {
	phone: '+48 791 567 011',
	email: 'contact@perfectwnetrza.pl',
	address: 'Kraków i okolice',
	hours: 'Pon–Pt 8:00–18:00',
};

// Web3Forms delivers submissions to all.perfectwnetrza@gmail.com (key is tied to that inbox).
// Set PUBLIC_WEB3FORMS_KEY in .env locally and in Vercel's environment variables.
const formKey = import.meta.env.PUBLIC_WEB3FORMS_KEY as string | undefined;
---

<section class="section contact" id="kontakt">
	<div class="container grid">
		<div class="info">
			<span class="eyebrow">Kontakt</span>
			<h2 class="section-title">Porozmawiajmy o Twoim wnętrzu</h2>
			<p class="intro">
				Opisz krótko, jakie prace planujesz — odezwiemy się w ciągu 24 godzin i umówimy bezpłatną
				konsultację oraz wycenę.
			</p>

			<dl class="details">
				<div>
					<dt>Telefon</dt>
					<dd><a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a></dd>
				</div>
				<div>
					<dt>E-mail</dt>
					<dd><a href={`mailto:${contact.email}`}>{contact.email}</a></dd>
				</div>
				<div>
					<dt>Adres</dt>
					<dd>{contact.address}</dd>
				</div>
				<div>
					<dt>Godziny</dt>
					<dd>{contact.hours}</dd>
				</div>
			</dl>
		</div>

		<form
			class="form"
			method="post"
			action="https://api.web3forms.com/submit"
			data-contact-form
			data-phone={contact.phone}
			data-email={contact.email}
		>
			<input type="hidden" name="access_key" value={formKey ?? ''} />
			<input type="hidden" name="subject" value="Nowe zapytanie ze strony PerfectWnętrza" />
			<input type="hidden" name="from_name" value="PerfectWnętrza — formularz" />
			<!-- Honeypot: hidden from people, bots tick it and get filtered out. -->
			<input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />

			{
				!formKey && (
					<p class="form-status is-error" role="status">
						Formularz jest chwilowo niedostępny — zadzwoń pod{' '}
						<a href={`tel:${contact.phone.replace(/\s/g, '')}`}>{contact.phone}</a> lub napisz na{' '}
						<a href={`mailto:${contact.email}`}>{contact.email}</a>.
					</p>
				)
			}

			<div class="row">
				<label>
					<span>Imię i nazwisko</span>
					<input type="text" name="name" autocomplete="name" required />
				</label>
				<label>
					<span>Telefon</span>
					<input type="tel" name="Telefon" autocomplete="tel" />
				</label>
			</div>
			<label>
				<span>E-mail</span>
				<input type="email" name="email" autocomplete="email" required />
			</label>
			<Select
				name="Rodzaj prac"
				label="Rodzaj prac"
				options={services}
				value={service}
			/>
			<label>
				<span>Wiadomość</span>
				<textarea name="Wiadomość" rows="5" placeholder="Metraż, lokalizacja, oczekiwany termin…" required></textarea>
			</label>
			<button type="submit" class="btn btn-primary" disabled={!formKey}>Wyślij zapytanie</button>
			<p class="note">Wysyłając formularz, zgadzasz się na kontakt w sprawie zapytania.</p>
			<p class="form-status" role="status" aria-live="polite" hidden></p>
		</form>
	</div>
</section>

<script>
	// Send the form in the background and show the result inside the form.
	// Without JavaScript the form still posts normally to Web3Forms.
	document.querySelectorAll<HTMLFormElement>('form[data-contact-form]').forEach((form) => {
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const status = form.querySelector<HTMLElement>('.form-status[aria-live]')!;
		const label = button.textContent;
		const { phone = '', email = '' } = form.dataset;

		const show = (kind: 'success' | 'error', html: string) => {
			status.hidden = false;
			status.className = `form-status is-${kind}`;
			status.innerHTML = html;
		};

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			button.disabled = true;
			button.textContent = 'Wysyłanie…';
			status.hidden = true;

			try {
				const response = await fetch(form.action, {
					method: 'POST',
					headers: { Accept: 'application/json' },
					body: new FormData(form),
				});
				const result = await response.json().catch(() => ({}));
				if (!response.ok || !result.success) throw new Error(result.message || response.statusText);

				form.reset();
				show('success', '<strong>Dziękujemy!</strong> Wiadomość została wysłana — odezwiemy się w ciągu 24 godzin.');
			} catch (error) {
				console.error('Contact form error:', error);
				show(
					'error',
					`Nie udało się wysłać wiadomości. Spróbuj ponownie albo zadzwoń pod ` +
						`<a href="tel:${phone.replace(/\s/g, '')}">${phone}</a> lub napisz na ` +
						`<a href="mailto:${email}">${email}</a>.`,
				);
			} finally {
				button.disabled = false;
				button.textContent = label;
			}
		});
	});
</script>

<style>
	.grid {
		display: grid;
		grid-template-columns: 1fr 1.1fr;
		gap: 80px;
		align-items: start;
	}
	.intro {
		margin-top: 24px;
		color: var(--muted);
		font-weight: 300;
		font-size: 17px;
		max-width: 440px;
	}
	.details {
		margin: 48px 0 0;
		display: grid;
		gap: 24px;
	}
	.details dt {
		font-size: 12px;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--muted);
	}
	.details dd {
		margin: 4px 0 0;
		font-family: var(--font-serif);
		font-size: 19px;
	}
	.details a {
		text-decoration: none;
	}
	.details a:hover {
		color: var(--accent);
	}

	.form {
		background: var(--surface);
		padding: 48px;
		border-radius: var(--radius);
		display: grid;
		gap: 22px;
	}
	.row {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 22px;
	}
	label {
		display: grid;
		gap: 8px;
	}
	label span {
		font-size: 13px;
		color: var(--muted);
	}
	input,
	select,
	textarea {
		width: 100%;
		font: inherit;
		font-size: 15px;
		color: var(--ink);
		background: transparent;
		border: 0;
		border-bottom: 1px solid var(--line);
		padding: 10px 0;
		border-radius: 0;
		transition: border-color 0.2s;
	}
	textarea {
		resize: vertical;
	}
	input:focus,
	select:focus,
	textarea:focus {
		outline: none;
		border-bottom-color: var(--accent);
	}
	.form .btn {
		justify-self: start;
		margin-top: 8px;
	}
	.form .btn:disabled {
		opacity: 0.55;
		cursor: not-allowed;
	}
	.botcheck {
		position: absolute;
		left: -9999px;
		width: 1px;
		height: 1px;
		opacity: 0;
	}
	.note {
		margin-top: -8px;
		font-size: 12px;
		color: var(--muted);
	}
	.form-status {
		padding: 14px 16px;
		font-size: 14px;
		line-height: 1.5;
		border-left: 3px solid;
		border-radius: var(--radius);
	}
	.form-status.is-success {
		color: var(--ink);
		background: var(--cream);
		border-color: var(--accent);
	}
	.form-status.is-error {
		color: #8a2f25;
		background: #fbeeec;
		border-color: #b5483b;
	}
	.form-status a {
		color: inherit;
		font-weight: 500;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 48px;
		}
	}
	@media (max-width: 520px) {
		.form {
			padding: 28px 20px;
		}
		.row {
			grid-template-columns: 1fr;
		}
		.form .btn {
			justify-self: stretch;
			justify-content: center;
		}
	}
</style>
