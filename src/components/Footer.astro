---
import { site, telHref } from '../data/site';
import { getLang, localize, useT } from '../i18n';
import { getServices } from '../lib/services';

const lang = getLang(Astro.url);
const t = useT(lang);
const f = t.footer;
const year = new Date().getFullYear();
const services = await getServices(lang);
const L = (path: string) => localize(path, lang);
---

<footer class="footer">
	<div class="container">
		<div class="top">
			<div class="brand">
				<a href={L('/')} class="logo" aria-label={t.common.home}>
					<img src="/logo.webp" alt="PerfectWnętrza" width="615" height="160" loading="lazy" />
				</a>
				<p>{f.tagline}</p>
			</div>

			<nav class="col" aria-label={f.navAria}>
				<h4>{f.navTitle}</h4>
				<a href={L('/')}>{t.nav.renovation}</a>
				<a href={L('/sprzatanie/')}>{t.nav.cleaning}</a>
				<a href={L('/#realizacje')}>{t.nav.projects}</a>
				<a href={L('/#kontakt')}>{t.nav.contact}</a>
			</nav>

			<nav class="col" aria-label={f.servicesTitle}>
				<h4>{f.servicesTitle}</h4>
				{services.map((s) => <a href={L(`/uslugi/${s.slug}/`)}>{s.data.name}</a>)}
			</nav>

			<div class="col">
				<h4>{f.contactTitle}</h4>
				<a href={telHref}>{site.phone}</a>
				<a href={`mailto:${site.email}`}>{site.email}</a>
				<span>{t.common.area}</span>
			</div>
		</div>

		<div class="bottom">
			<span>© {year} PerfectWnętrza. {f.rights}</span>
			<span class="links">
				<a href={L('/polityka-prywatnosci/')}>{f.privacy}</a>
				<a href="#top">{f.top}</a>
			</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--dark);
		color: var(--silver);
		padding: 80px 0 32px;
		border-top: 4px solid var(--bronze);
	}
	.top {
		display: grid;
		grid-template-columns: 1.6fr 1fr 1.2fr 1.2fr;
		gap: 48px;
		padding-bottom: 56px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.logo {
		display: inline-block;
	}
	.logo img {
		height: 64px;
		width: auto;
	}
	.brand p {
		margin-top: 20px;
		max-width: 300px;
		font-weight: 300;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	h4 {
		margin: 0 0 8px;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--bronze);
	}
	.col a,
	.bottom a {
		text-decoration: none;
		transition: color 0.2s;
	}
	.col a:hover,
	.bottom a:hover {
		color: var(--cream);
	}
	.links {
		display: flex;
		gap: 24px;
	}
	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding-top: 28px;
		font-size: 13px;
		color: var(--stone);
	}

	@media (max-width: 760px) {
		.top {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
