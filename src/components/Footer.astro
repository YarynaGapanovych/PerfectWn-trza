---
const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container">
		<div class="top">
			<div class="brand">
				<a href="#top" class="logo" aria-label="PerfectWnętrza — do góry">
					<img src="/logo.webp" alt="PerfectWnętrza" width="615" height="160" loading="lazy" />
				</a>
				<p>Wykończenia i remonty wnętrz pod klucz.</p>
			</div>

			<nav class="col" aria-label="Stopka">
				<h4>Nawigacja</h4>
				<a href="#top">Start</a>
				<a href="#uslugi">Usługi</a>
				<a href="#kontakt">Kontakt</a>
			</nav>

			<div class="col">
				<h4>Kontakt</h4>
				<a href="tel:+48791567011">+48 791 567 011</a>
				<a href="mailto:kontakt@example.com">kontakt@example.com</a>
				<span>Kraków i okolice</span>
			</div>
		</div>

		<div class="bottom">
			<span>© {year} PerfectWnętrza. Wszelkie prawa zastrzeżone.</span>
			<a href="#top">Do góry ↑</a>
		</div>
	</div>
</footer>

<style>
	.footer {
		background: var(--dark);
		color: var(--silver);
		padding: 80px 0 32px;
		border-top: 4px solid var(--bronze);
	}
	.top {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 48px;
		padding-bottom: 56px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
	}
	.logo {
		display: inline-block;
	}
	.logo img {
		height: 64px;
		width: auto;
	}
	.brand p {
		margin-top: 20px;
		max-width: 300px;
		font-weight: 300;
	}
	.col {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	h4 {
		margin: 0 0 8px;
		font-size: 12px;
		font-weight: 500;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--bronze);
	}
	.col a,
	.bottom a {
		text-decoration: none;
		transition: color 0.2s;
	}
	.col a:hover,
	.bottom a:hover {
		color: var(--cream);
	}
	.bottom {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		flex-wrap: wrap;
		padding-top: 28px;
		font-size: 13px;
		color: var(--stone);
	}

	@media (max-width: 760px) {
		.top {
			grid-template-columns: 1fr 1fr;
		}
		.brand {
			grid-column: 1 / -1;
		}
	}
</style>
