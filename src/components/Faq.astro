---
// Frequently asked questions as an accordion, plus FAQPage structured data for Google.
export interface FaqItem {
	q: string;
	a: string;
}

interface Props {
	items: FaqItem[];
}

import { getLang, useT } from '../i18n';

const t = useT(getLang(Astro.url)).faq;
const { items } = Astro.props;
const { eyebrow, title } = t;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
};
---

<section class="section faq">
	<div class="container grid">
		<div>
			<span class="eyebrow">{eyebrow}</span>
			<h2 class="section-title">{title}</h2>
			<p class="intro">
				{t.introBefore} <a href="#kontakt">{t.introLink}</a> {t.introAfter}
			</p>
		</div>
		<div class="list">
			{
				items.map((item, i) => (
					<details open={i === 0}>
						<summary>
							{item.q}
							<span class="plus" aria-hidden="true" />
						</summary>
						<p>{item.a}</p>
					</details>
				))
			}
		</div>
	</div>
	<script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
	.faq {
		background: var(--surface);
	}
	.grid {
		display: grid;
		grid-template-columns: 1fr 1.6fr;
		gap: 64px;
		align-items: start;
	}
	.intro {
		margin-top: 24px;
		color: var(--muted);
		font-weight: 300;
	}
	.intro a {
		color: var(--accent-dark);
	}
	details {
		border-bottom: 1px solid var(--line);
	}
	details:first-child {
		border-top: 1px solid var(--line);
	}
	summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 24px;
		padding: 22px 0;
		font-family: var(--font-serif);
		font-size: 18px;
		cursor: pointer;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary:hover {
		color: var(--accent-dark);
	}
	.plus {
		position: relative;
		flex: none;
		width: 14px;
		height: 14px;
	}
	.plus::before,
	.plus::after {
		content: '';
		position: absolute;
		top: 50%;
		left: 0;
		width: 14px;
		height: 1.5px;
		background: var(--accent);
		transition: transform 0.25s;
	}
	.plus::after {
		transform: rotate(90deg);
	}
	details[open] .plus::after {
		transform: rotate(0deg);
	}
	details p {
		padding: 0 40px 24px 0;
		color: var(--muted);
		font-size: 15px;
	}
	@media (max-width: 900px) {
		.grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
	}
</style>
